dist_disp[dist_disp < 0] <- 0.001
# moran operator M(W)
W <- matrix(0, J, J)
for (k in unique(area_id)) {
idx <- which(area_id == k)
W[idx, idx] <- 1
}
diag(W) <- 0
# check for Z variable ...
z <- rnorm(J, mean = 0, sd = 0.5)
# now z_D
ck <- fields::Krig(dist_true,z,aRange=50)
ck <- predict(ck, dist_disp)
## MW matrix
z_D <- as.matrix(ck)
#MW <- (1 - z_D[,1] %*% solve(t(z_D[,1]) %*% z_D[,1]) %*% t(z_D[,1])) %*%
#  W %*%
#  (1 - z_D[,1] %*% solve(t(z_D[,1]) %*% z_D[,1]) %*% t(z_D[,1]))
