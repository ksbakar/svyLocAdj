x_ij <- rnorm(N)
#alpha <- 1
#beta  <- 0.5
#zeta  <- 0.5
eps_y <- rnorm(N,0,sigma_y)
y <- alpha +
beta * x_ij +
zeta * rep(z, each = n_j) + eps_y
