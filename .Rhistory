#eigen_QQ <- eigen(QQ)
#Sigma_diag <- abs(diag(eigen_QQ$vectors)) # mx1
#
#Psi <- (M_JxJ%*%Phi_star)%*%Sigma_diag # Jx1
#
#z_DD <- as.vector(z + Psi)
#
# individual-level
x_ij <- rnorm(N)
#alpha <- 1
#beta  <- 0.5
#zeta  <- 0.5
eps_y <- rnorm(N,0,sigma_y)
y <- alpha +
beta * x_ij +
zeta * rep(z, each = n_j) + eps_y
#zeta * rep(z_star, each = n_j) + eps_y
#p <- plogis(linpred)
#y <- rbinom(N, 1, prob = p)
dat_sim <- data.frame(
cluster_id = rep(1:J, each = n_j),
area_id    = rep(area_id, each = n_j),
urban      = rep(urban, each = n_j),
x_ij       = x_ij,
#z_star     = rep(z_star, each = n_j),
z_star     = rep(z, each = n_j),
z_D        = rep(z_D, each = n_j),
y          = y,
coords_x   = rep(cluster_coords_disp[,1], each = n_j),
coords_y   = rep(cluster_coords_disp[,2], each = n_j)
)
dat_sim
}
dat <- data_fnc(sigma_u=1,sigma_r=3,
urban_displacement = c(0,2000), # in meters
rural_displacement = c(2000,5000) # in meters
)
plot(dat$z_D,dat$z_star)
summary(lm(y ~ x_ij + z_D, data = dat))
summary(lm(y ~ x_ij + z_star, data = dat))
# now z_D
