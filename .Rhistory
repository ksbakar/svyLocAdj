devtools::install_github("ksbakar/svyLocAdj")
devtools::install_github("ksbakar/svyLocAdj")
library(svyLocAdj)
?svymodel
y <- read.csv("ghana_data.csv")
y <- read.csv("ghana_data.csv")
out_bino = svymodel(formula = ch_stunt ~ age_of_child,
data = y, family = "binomial",
id_var = c("DHSCLUST"),
coord_var = c("LONGNUM","LATNUM"),
cluster_var = c("Precipitation_2020"),
urban_rural_var = c("URBAN_RURA"))
out_bino
summary(out_bino)
plot(out_bino, type="para",  title = "Binomial model")
?plot
plot(out_bino, type="para",  title = "Binomial model",  drop_intercept = FALSE)
plot(out_bino, type="para",  title = "Binomial model",  drop_intercept = TRUE)
plot(out_bino, type="map")
