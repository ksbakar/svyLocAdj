...){
# type=="para" or "map"
if(type=="map"){
print(x$sp_data$plot)
}
if(type=="para"){
# forest plot
if(x$results$family%in%"binomial"){
df <- x$results$fixed_parameters
df <- data.frame(
variable = rownames(df),
OR = df[, "OR_median"],
lower = df[, "OR_lower_95"],
upper = df[, "OR_upper_95"]
)
if(isTRUE(drop_intercept)){ df = df[-1,]}
# forest plot
p <- ggplot(df, aes(x = OR, y = variable)) +
geom_point(size = 3) +
geom_errorbarh(aes(xmin = lower, xmax = upper), width = 0.2) +
geom_vline(xintercept = 1, linetype = "dashed") +
scale_x_log10() +
labs(
x = "Odds Ratio (95\% Credible Interval)",
