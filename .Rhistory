cluster_coords_disp <- st_coordinates(displaced_sf)
area_coords <- st_coordinates(grid_midpoints)        # m x 2
area_id <- original_sf$area_id
urban <- ifelse(original_sf$type == "Urban", 1, 0)
# geodetic distances (km)
dist_true <- geodist(
