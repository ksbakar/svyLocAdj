title = "Forest Plot of Fixed Effects",
drop_intercept = FALSE,
...){
# type=="para" or "map"
if(type=="map"){
print(x$sp_data$plot)
}
if(type=="para"){
# forest plot
if(x$results$family%in%"binomial"){
df <- x$results$fixed_parameters
df <- data.frame(
variable = rownames(df),
est = df[, "OR_median"],
lower = df[, "OR_lower_95"],
upper = df[, "OR_upper_95"]
)
if(isTRUE(drop_intercept)){ df = df[-1,]}
# forest plot
p <- ggplot(df, aes(x = est, y = variable)) +
# point estimate (bigger + subtle fill)
geom_point(size = 3.5, shape = 21, fill = "#2C7FB8", color = "black", stroke = 0.4) +
# confidence interval (thicker + softer color)
geom_errorbarh(aes(xmin = lower, xmax = upper),
height = 0.15,
linewidth = 0.8,
color = "gray35") +
# reference line
geom_vline(xintercept = 1, linetype = "dashed", linewidth = 0.8, color = "gray50") +
# log scale with nice breaks
scale_x_log10(
breaks = scales::pretty_breaks(n = 6),
labels = scales::label_number(accuracy = 0.01)
) +
# clean labels
labs(
x = "Odds Ratio",
y = NULL,
title = title
) +
# better theme
theme_minimal(base_size = 13) +
theme(
plot.title = element_text(face = "bold", size = 14),
axis.text.y = element_text(size = 11),
axis.text.x = element_text(size = 10),
panel.grid.minor = element_blank(),
panel.grid.major.y = element_blank(),
plot.title.position = "plot",
plot.title = element_text(hjust = 0.5)
)
print(p)
}
if(x$results$family%in%"gaussian"){
df <- x$results$fixed_parameters
df <- data.frame(
variable = rownames(df),
est = df[, "median"],
lower = df[, "lower_95"],
upper = df[, "upper_95"]
)
if(isTRUE(drop_intercept)){ df = df[-1,]}
# forest plot
p <- ggplot(df, aes(x = est, y = variable)) +
geom_point(size = 3) +
geom_errorbarh(aes(xmin = lower, xmax = upper), width = 0.2) +
geom_vline(xintercept = 1, linetype = "dashed") +
scale_x_log10() +
labs(
x = "Estimates",
y = NULL,
title = title
) +
theme_minimal()
print(p)
}
if(x$results$family%in%"poisson"){
}
}
}
plot(out_bino, type="para")
