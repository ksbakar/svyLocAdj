#p <- plogis(linpred)
#y <- rbinom(N, 1, prob = p)
dat_sim <- data.frame(
cluster_id = rep(1:J, each = n_j),
area_id    = rep(area_id, each = n_j),
urban      = rep(urban, each = n_j),
x_ij       = x_ij,
z_star     = rep(z, each = n_j),
z_D        = rep(z_D, each = n_j),
y          = y,
coords_x   = rep(cluster_coords_disp[,1], each = n_j),
coords_y   = rep(cluster_coords_disp[,2], each = n_j)
)
dat_sim
}
dat <- data_fnc(sigma_u=1,sigma_r=3,
urban_displacement = c(0,2000), # in meters
rural_displacement = c(2000,5000) # in meters
)
plot(dat$z_D,dat$z_star)
